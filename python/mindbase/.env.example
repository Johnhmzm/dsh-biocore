# OpenAI-compatible endpoint (Ollama / vLLM / LM Studio / llama.cpp / cloud)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=minicpm-v-4.7
# MiniCPM-V 4.7 emits reasoning first; disable it so content is the reply
LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}
# Optional expression-layer character prompt (does not own base state)
# LLM_CHARACTER_PROMPT_FILE=docs/persona-v2-new.md
