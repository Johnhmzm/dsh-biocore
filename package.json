{
    "name":  "dsh-biocore",
    "version":  "0.6.9",
    "type":  "module",
    "description":  "BioCore DSH UI: per-session state tab, standalone instrument panel, /api/biocore/state, session/event one_turn updates, /bio sync.",
    "main":  "lib/index.js",
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "docs",
                  "ui",
                  "python"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           },
                "marketplace":  {
                                    "profiles":  [
                                                     "web"
                                                 ],
                                    "requiresRestart":  true
                                },
                "permissions":  {
                                    "files":  "read-write",
                                    "network":  "none",
                                    "commands":  "none",
                                    "credentials":  [

                                                    ]
                                },
                "compatibility":  {
                                      "dsh":  "\u003e=0.2.0 \u003c0.3.0",
                                      "node":  "\u003e=22"
                                  }
            },
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json",
                    "./compaction":  "./lib/compaction.js"
                },
    "scripts":  {
                    "selftest":  "node test/selftest.mjs",
                    "selftest:204":  "node test/selftest-task204.mjs",
                    "selftest:210":  "node test/selftest-task210.mjs",
                    "hook":  "node test/hook-wiring.mjs",
                    "demo":  "node test/bio-sync.mjs",
                    "test":  "node --test test/*.mjs",
                    "test:integration":  "node --test test/integration/*.mjs"
                },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "biocore"
                 ],
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "~4.1.0",
                             "@deepseek-ai/dsh-compaction":  "~0.2.2-rc.1",
                             "@deepseek-ai/dsh-llm":  "~0.2.2-rc.1",
                             "@deepseek-ai/dsh-session":  "~0.2.2-rc.1",
                             "@deepseek-ai/dsh-token-meter":  "~0.2.2-rc.1",
                             "@deepseek-ai/dsh-agent":  "~0.2.2-rc.1",
                             "@deepseek-ai/dsh-compaction-basic":  "~0.2.2-rc.1"
                         },
    "peerDependenciesMeta":  {
                                 "@deepseek-ai/cordis":  {
                                                             "optional":  true
                                                         },
                                 "@deepseek-ai/dsh-compaction":  {
                                                                     "optional":  true
                                                                 },
                                 "@deepseek-ai/dsh-llm":  {
                                                              "optional":  true
                                                          },
                                 "@deepseek-ai/dsh-session":  {
                                                                  "optional":  true
                                                              },
                                 "@deepseek-ai/dsh-token-meter":  {
                                                                      "optional":  true
                                                                  },
                                 "@deepseek-ai/dsh-agent":  {
                                                                "optional":  true
                                                            },
                                 "@deepseek-ai/dsh-compaction-basic":  {
                                                                           "optional":  true
                                                                       }
                             }
}
